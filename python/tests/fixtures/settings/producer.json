{
  "description": "Complete producer payload, with host variables resolved and document CWD variables deferred.",
  "toolDefaults": {
    "severity": { "E": "Error", "W": "Warning" },
    "extensionOption": { "enabled": true, "label": "default" }
  },
  "configuration": {
    "workspace": {
      "cwd": "${workspaceFolder}__SEP__${relativeFileDirname}",
      "args": [
        "--label",
        "café",
        "--config",
        "${workspaceFolder}__SEP__tool.toml"
      ],
      "path": [],
